# WildQuest AI — Configuration Example
# Local Open-Weight Gemma AI Endpoint (typically Ollama running locally)
VITE_GEMMA_ENDPOINT=http://localhost:11434
# Default model name (gemma2:2b, gemma2:9b, or gemma:2b)
VITE_GEMMA_MODEL=gemma2:2b
# AI generation timeout in milliseconds (default: 30000)
VITE_GEMMA_TIMEOUT_MS=30000

# Telemetry / Tracing (Optional Sentry DSN for non-sensitive agent performance tracing)
# Never sends personal reflections, photos, or journal entries.
VITE_SENTRY_DSN=
VITE_ENVIRONMENT=development
